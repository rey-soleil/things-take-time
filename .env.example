# To run this locally, copy this file to .env.local and fill in the values

# Server-side Todoist personal API token
# TODOIST_API_TOKEN=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# PERSONAL_CALENDAR_ID=

# Existing user storage and NextAuth session secret (also encrypts each user's Notion token)
# MONGODB_URI=
# NEXTAUTH_SECRET=
# Notion is connected per user in the app; do not put its token in NEXT_PUBLIC_*.
